{
  "name": "anime-tierlist-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && tsc -p tsconfig.worker.json --noEmit false --outDir .next/offline-worker && node scripts/build-offline-assets.mts",
    "start": "next start",
    "lint": "pnpm check",
    "format": "biome check --write .",
    "check": "biome check . --error-on-warnings && node scripts/check-tailwind.mts",
    "typecheck": "next typegen && tsc --noEmit && tsc --noEmit -p tsconfig.worker.json",
    "test": "vitest",
    "test:run": "vitest run",
    "verify": "pnpm check && pnpm typecheck && pnpm test:run && pnpm build",
    "prepare": "husky",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test:storybook": "vitest run --config vitest.storybook.config.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@prisma/orm-postgres": "8.0.0-rc.18",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "dotenv": "18.0.8",
    "lucide-react": "^1.61.0",
    "motion": "14.5.0",
    "next": "16.4.2",
    "next-themes": "0.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "shadcn": "^4.22.1",
    "temporal-polyfill": "1.0.6",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@storybook/addon-a11y": "11.0.0-alpha.7",
    "@storybook/addon-docs": "11.0.0-alpha.7",
    "@storybook/addon-themes": "11.0.0-alpha.7",
    "@storybook/addon-vitest": "11.0.0-alpha.7",
    "@storybook/nextjs-vite": "11.0.0-alpha.7",
    "@tailwindcss/turbopack": "^4",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/browser-playwright": "^5.0.5",
    "husky": "9.1.7",
    "jsdom": "30.1.3",
    "playwright": "1.64.1",
    "prisma": "8.0.0-rc.24",
    "storybook": "11.0.0-alpha.7",
    "tailwindcss": "^4",
    "typescript": "7.1.0-beta",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "packageManager": "pnpm@10.33.2",
  "type": "module",
  "engines": {
    "node": "24.x",
    "pnpm": "10.33.2"
  },
  "volta": {
    "node": "24.16.0"
  }
}
