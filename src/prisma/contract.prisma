// use prisma-8

model TierlistOwner {
  id       String @id
  seedHash String @unique
  revision Int
  document Jsonb

  @@index([document], type: "gin")
}

model TierlistSession {
  tokenHash String @id
  ownerId   String
  owner     TierlistOwner @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  expiresAt BigInt

  @@index([ownerId])
  @@index([expiresAt])
}

model TierlistShare {
  id String @id
  ownerId String
  owner TierlistOwner @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  fingerprint String
  document Jsonb

  @@unique([ownerId, fingerprint])
}

model TierlistRateLimit {
  id        String @id
  attempts  Int
  expiresAt BigInt

  @@index([expiresAt])
}

model TierlistGoogleAccount {
  subject String @id
  ownerId String @unique
  owner TierlistOwner @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  encryptedSeed String?
  displayName String?
}

model AuthUser {
  id String @id
  name String
  email String @unique
  emailVerified Boolean
  image String?
  createdAt TimestampString(3)
  updatedAt TimestampString(3)
}

model AuthSession {
  id String @id
  token String @unique
  userId String
  user AuthUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt TimestampString(3)
  createdAt TimestampString(3)
  updatedAt TimestampString(3)
  ipAddress String?
  userAgent String?

  @@index([userId])
  @@index([expiresAt])
}

model AuthAccount {
  id String @id
  accountId String
  providerId String
  userId String
  user AuthUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken String?
  refreshToken String?
  idToken String?
  accessTokenExpiresAt TimestampString(3)?
  refreshTokenExpiresAt TimestampString(3)?
  scope String?
  password String?
  createdAt TimestampString(3)
  updatedAt TimestampString(3)

  @@unique([providerId, accountId])
  @@index([userId])
}

model AuthVerification {
  id String @id
  identifier String
  value String
  expiresAt TimestampString(3)
  createdAt TimestampString(3)
  updatedAt TimestampString(3)

  @@index([identifier])
  @@index([expiresAt])
}

model AuthRateLimit {
  id String @id
  key String @unique
  count Int
  lastRequest BigInt
}

model TierlistPng {
  shareId String @id
  share TierlistShare @relation(fields: [shareId], references: [id], onDelete: Cascade)
  url String?
  fingerprint String?
  lastUsedAt BigInt
  leaseToken String?
  leaseUntil BigInt?

  @@index([lastUsedAt])
}
